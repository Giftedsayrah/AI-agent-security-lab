# --- Agent (set these in the terminal where you run the agent) ---
# PROVIDER is anthropic (default), gemini, openai or groq. Set the matching key:
PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key
# Only if Anthropic says the key is not scoped to a workspace (a 400 error):
# ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id
GEMINI_API_KEY=your-gemini-key      # new keys start with AQ.
OPENAI_API_KEY=your-openai-key      # starts with sk-
GROQ_API_KEY=your-groq-key          # starts with gsk_
# MODEL_NAME overrides the default model for the chosen provider
# MODEL_NAME=
# Optional: REASONING_EFFORT=low for faster replies, LLM_TIMEOUT=120 to wait longer
# PROMPT_MODE=loose makes the agent trust knowledge-base articles, so real models are easier to fool
# PROMPT_MODE=strict
# EVENT_LOG=logs/agent-events.jsonl
# KB_DIR=data/kb

# --- Docker Compose lab (copy this file to .env in the project folder) ---
ELASTIC_VERSION=8.15.3
ELASTIC_PASSWORD=change-me-elastic
KIBANA_PASSWORD=change-me-kibana
# any random string of 32+ characters
KIBANA_ENCRYPTION_KEY=replace-with-a-random-string-of-32-or-more-characters

# --- Optional LiteLLM proxy ---
# Put the real key here; then point the agent at the proxy with:
#   ANTHROPIC_BASE_URL=http://localhost:4000
#   ANTHROPIC_API_KEY=<the LITELLM_MASTER_KEY below>
REAL_ANTHROPIC_API_KEY=your-anthropic-key
LITELLM_MASTER_KEY=sk-lab-change-me
